# Copy to .env and fill in. Never commit .env.

# Google account whose Drive holds the plans (they're shared from here to each traveller)
OWNER_EMAIL=

# ID of the form's response sheet, printed by: python tools/fetch_form_requests.py --create-sheet
FORM_SHEET_ID=

# Gmail App Password for OWNER_EMAIL, used by tools/send_plan_email.py (see README: Emailing plans)
GMAIL_APP_PASSWORD=
